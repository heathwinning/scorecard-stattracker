{
  "name": "scorecard-stattracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:build": "next build && npx @cloudflare/next-on-pages",
    "cf:deploy": "npm run cf:build && wrangler pages deploy .vercel/output/static --project-name=scorecard-stattracker",
    "db:create": "wrangler d1 create scorecard-db",
    "db:migrate:local": "wrangler d1 execute scorecard-db --local --file=./database/schema.sql",
    "db:migrate:prod": "wrangler d1 execute scorecard-db --remote --file=./database/schema.sql",
    "db:seed:local": "wrangler d1 execute scorecard-db --local --file=./database/seed.sql",
    "db:seed:prod": "wrangler d1 execute scorecard-db --remote --file=./database/seed.sql"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "expr-eval": "^2.0.2",
    "jose": "^5.2.3",
    "next": "^14.2.35",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.2.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.11.0",
    "@cloudflare/workers-types": "^4.20240512.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.0",
    "wrangler": "^3.57.0"
  }
}
